# Copier ce fichier en .env.local (jamais versionné) et remplir au jalon M13.
# Sans ces valeurs, Fabrics fonctionne en mode local (projets dans le navigateur).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
# Clé "anon" (publique) uniquement. Ne jamais mettre la clé service_role ici.
VITE_SUPABASE_ANON_KEY=

# M14 : serveur temps réel (Cloudflare Worker, dossier collab-server/), par exemple
# https://fabrics-collab.<votre-sous-domaine>.workers.dev
# Vide : pas de collaboration en direct, l'éditeur fonctionne comme avant.
VITE_COLLAB_URL=
