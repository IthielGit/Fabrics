# Copier ce fichier en .env.local (jamais versionné) et remplir au jalon M12.
# Sans ces valeurs, Fabrics fonctionne en mode local (projets dans le navigateur).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
# Clé "anon" (publique) uniquement. Ne jamais mettre la clé service_role ici.
VITE_SUPABASE_ANON_KEY=
